PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/clipai
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
ADMIN_EMAIL=admin@clipai.dev
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=ClipAI Admin
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# AI keys — same variable names for free now and paid production.
# Free keys: local / current live demo
# Paid keys: put NEW keys only on the server .env after you enable billing.
# Code does not change. You only replace the key values.
# ---------------------------------------------------------------------------
USE_MOCK_AI=false

# Talking-head speech cuts (Whisper). Required for good jump-cuts.
# Free now: https://console.groq.com → API Keys
# Paid later: same console → Billing → Developer, then create a new key
GROQ_API_KEY=

# Titles, AI Combine, optional captions.
# Free now: https://aistudio.google.com → Get API key
# Paid later: same project → Set up billing, then create a new key
GEMINI_API_KEY=

# Not used for talking-head / ASMR (local FFmpeg). Leave empty.
DEEPGRAM_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# true = skip Gemini waits + lighter 720p encode (fine for local/demo)
# production paid: set FAST_EXPORT=false so titles/polish actually run
FAST_EXPORT=true

# Optional later: CDN for finished MP4s. Editing stays on the VPS.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local: Gmail app password is OK. Production: Resend/SendGrid.
DEFAULT_SMTP_EMAIL=you@gmail.com
DEFAULT_SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
