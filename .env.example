PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/clipai
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
ADMIN_EMAIL=admin@clipai.dev
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=ClipAI Admin
UPLOAD_DIR=uploads
# Talking-head uses free local FFmpeg (always real cuts).
# Optional free STT transcript: https://console.groq.com/ → GROQ_API_KEY
USE_MOCK_AI=false
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
# Faster VPS demos: skip Gemini waits + polish; ultrafast 720p cuts
FAST_EXPORT=true
# Cloudinary — CDN delivery of finished MP4s (FFmpeg editing stays on server)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Gmail SMTP (use a Google App Password, not your normal password)
DEFAULT_SMTP_EMAIL=you@gmail.com
DEFAULT_SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
