# Copy to the LIVE server only: /var/www/mernstackprojects/ClipAI-backend/.env
# Do not use these values on your laptop. Do not commit this file with real keys.

PORT=4000
NODE_ENV=production
FAST_EXPORT=false
USE_MOCK_AI=false

# Dedicated Atlas cluster (not the local/dev database)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/clipai?retryWrites=true&w=majority

# Long random secret — different from local
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://182.255.88.83:3001
PUBLIC_API_URL=http://182.255.88.83:3001
ADMIN_EMAIL=admin@clipai.dev
ADMIN_PASSWORD=change-this
ADMIN_NAME=ClipAI Admin
UPLOAD_DIR=uploads

# Paid Groq Developer key (same GROQ_API_KEY name as free)
# console.groq.com → Billing → new API key
GROQ_API_KEY=

# Paid Gemini key (same GEMINI_API_KEY name as free)
# aistudio.google.com → billing on the Cloud project → new API key
GEMINI_API_KEY=

DEEPGRAM_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production mail (Resend SMTP recommended)
DEFAULT_SMTP_EMAIL=noreply@yourdomain.com
DEFAULT_SMTP_PASSWORD=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
